# Pflicht in Produktion
APP_PASSWORD=ein-langes-passwort
SECRET_KEY=zufaelliger-langer-string   # python -c "import secrets; print(secrets.token_hex(32))"

# Datenablage (Railway: Volume auf /data mounten)
DATA_DIR=./data

# Speiseplan
ROTATION_START=2026-11-02     # ein Montag = Rotationswoche 1 (optional, sonst aktuelle Woche)
PLAN_DAYS=7                   # so viele Tage im Voraus wird eingekauft
TK_CAPACITY_G=4000            # Tiefkühlfach fasst ca. so viel Gramm; die TK-Reserve wird entsprechend gekürzt
RESERVE_DAYS=10               # haltbare Zutaten (Vorrat, TK) für so viele Plan-Tage immer vorrätig
TZ_NAME=Europe/Berlin

# Google Keep (optional – ohne diese Werte läuft die App ohne Sync)
KEEP_EMAIL=
KEEP_MASTER_TOKEN=
KEEP_LIST_TITLE=Einkaufsliste
KEEP_SYNC_INTERVAL_MIN=10

# Lokal ohne HTTPS: 0 setzen, sonst funktioniert der Login-Cookie nicht
SESSION_COOKIE_SECURE=1
